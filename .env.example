# Copy this file to `.env` and fill in your Atlas connection string.
# (The script reads these via environment variables; load them however you like,
#  e.g. `export $(grep -v '^#' .env | xargs)` on macOS/Linux.)

SOURCE_URI=mongodb://localhost:27017
SOURCE_DB=nse_fno

# Paste your MongoDB Atlas free-tier string here (keep it secret!):
DEST_URI=mongodb+srv://<user>:<password>@<cluster>.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Optional: write to a different db name on Atlas (defaults to SOURCE_DB)
# DEST_DB=nse_fno
